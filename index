    var top=el.getBoundingClientRect().top+window.pageYOffset-20;
    // Try all scroll methods for iframe compatibility
    try{ window.scrollTo({top:top,behavior:'smooth'}); } catch(e){}
    try{ document.documentElement.scrollTop=top; } catch(e){}
    try{ document.body.scrollTop=top; } catch(e){}
    try{ el.scrollIntoView({behavior:'smooth',block:'start'}); } catch(e){}
  }
  show(0);
</script>
</body>
</html>
